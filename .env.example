# Self-hosted local Keycloak bootstrap secrets. Use unique random values.
KEYCLOAK_DB_PASSWORD=replace-with-a-long-random-database-password
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-admin-password

# Browser-facing issuer must exactly match the issuer claim in access tokens.
OIDC_ISSUER=http://localhost:8080/realms/mosaic
OIDC_AUDIENCE=mosaic-api
# This URL is used only by the MOSAIC backend to retrieve signing keys.
OIDC_JWKS_URL=http://keycloak:8080/realms/mosaic/protocol/openid-connect/certs
OIDC_CLIENT_ID=mosaic-web
OIDC_REDIRECT_URI=http://localhost:8000/
DATABASE_URL=sqlite:////data/mosaic.db
