# Local single-operator preview only. Never use this mode for customer data.
MOSAIC_PREVIEW_USERNAME=owner
MOSAIC_PREVIEW_PASSWORD=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./mosaic.db

# Multi-user mode: configure all three OIDC values together.
# When any OIDC value is set, Basic preview auth is disabled and the API fails closed
# unless all values are present. The frontend still needs an OIDC PKCE login client.
OIDC_ISSUER=https://identity.example.com/realms/mosaic
OIDC_AUDIENCE=mosaic-api
OIDC_JWKS_URL=https://identity.example.com/realms/mosaic/protocol/openid-connect/certs
